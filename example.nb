Cell["Text paragraphs", "Item"],
Cell["Bullet lists", "Item"],
Cell["Code blocks", "Item"],
Cell["Mathematical Examples", "Section"],
Cell["Simple Functions", "Subsection"],
Cell["Let's define a simple quadratic function:", "Text"],
Cell["f[x_] := x^2 + 2*x + 1\\nf[5]", "Code"],
Cell["Plotting", "Subsection"],
Cell["Create a basic plot:", "Text"],
Cell["Plot[Sin[x], {x, 0, 2 Pi}]", "Code"],
Cell["Data Visualization", "Subsection"],
Cell["Generate and plot some data:", "Text"],
Cell["data = Table[{i, Sin[i]}, {i, 0, 2 Pi, 0.1}];\\nListPlot[data, PlotStyle -> Red]", "Code"],
Cell["Advanced Topics", "Section"],
Cell["Multiple Expressions", "Subsection"],
